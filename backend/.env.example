# Backend Environment Variables
# Copie este arquivo para .env e preencha os valores

# ===== OBRIGATÓRIAS =====
SECRET_KEY=sua-chave-secreta-aleatoria-muito-longa-aqui

# Modo debug: True apenas em desenvolvimento local
DEBUG=False

# ===== PRODUÇÃO (Render) =====
RENDER_EXTERNAL_HOSTNAME=seu-app.onrender.com
FRONTEND_URL=https://seu-app.vercel.app
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# ===== CLOUDINARY (armazenamento de arquivos) =====
CLOUD_NAME=sua-cloud-name
API_KEY=sua-api-key
API_SECRET=seu-api-secret

# ===== SEGURANÇA EXTRA (opcional) =====
# Personaliza a URL do painel admin (padrão: tcip-painel-restrito)
ADMIN_URL=tcip-painel-restrito
